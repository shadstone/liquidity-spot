# Remote deployments must use HTTPS.
SHAKESCAPE_BOARD_NETWORK=mainnet
# Configure only after ShakeScape mobile/extension support an exact URI with
# one {offer_id} and one {network} placeholder.
SHAKESCAPE_OFFER_URI_TEMPLATE=
